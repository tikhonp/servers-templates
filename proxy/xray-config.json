{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "vless-ws",
      "port": 10001,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "VLESS_CLIENT_UUID"
          }
        ],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "VLESS_WS_PATH"
        }
      }
    },
    {
      "tag": "vless-xhttp",
      "port": 10002,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "VLESS_CLIENT_UUID"
          }
        ],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "VLESS_XHTTP_PATH",
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000"
          }
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct-outbound",
      "protocol": "freedom"
    }
  ]
}
